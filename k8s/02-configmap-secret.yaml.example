---
# ConfigMap for Application Configuration
# Stores non-sensitive configuration data
apiVersion: v1
kind: ConfigMap
metadata:
  name: python-app-config
  namespace: production
  labels:
    app: python-app
    component: config
data:
  # Application version
  APP_VERSION: "1.0.0"
  
  # Environment name
  ENVIRONMENT: "production"
  
  # Logging configuration
  LOG_LEVEL: "INFO"
  
  # Application settings
  APP_NAME: "Python Flask Application"
  
  # Feature flags
  ENABLE_DEBUG: "false"
  ENABLE_METRICS: "true"

---
# Secret for Sensitive Configuration
# Stores sensitive data like API keys, passwords, etc.
# Note: Values must be base64 encoded
# To encode: echo -n "your-value" | base64
apiVersion: v1
kind: Secret
metadata:
  name: python-app-secret
  namespace: production
  labels:
    app: python-app
    component: secret
type: Opaque
data:
  # Replace with your actual base64 encoded values
  # Example: echo -n "your-api-key-here" | base64
  API_KEY: REPLACE_WITH_BASE64_ENCODED_API_KEY
  
  # Example: echo -n "your-db-password" | base64
  DB_PASSWORD: REPLACE_WITH_BASE64_ENCODED_DB_PASSWORD
  
  # Example: echo -n "your-secret-token" | base64
  SECRET_TOKEN: REPLACE_WITH_BASE64_ENCODED_SECRET_TOKEN

---
# ConfigMap for Development Environment
apiVersion: v1
kind: ConfigMap
metadata:
  name: python-app-config
  namespace: development
  labels:
    app: python-app
    component: config
data:
  APP_VERSION: "1.0.0-dev"
  ENVIRONMENT: "development"
  LOG_LEVEL: "DEBUG"
  APP_NAME: "Python Flask Application (Dev)"
  ENABLE_DEBUG: "true"
  ENABLE_METRICS: "false"

---
# Secret for Development Environment
apiVersion: v1
kind: Secret
metadata:
  name: python-app-secret
  namespace: development
  labels:
    app: python-app
    component: secret
type: Opaque
data:
  # Development credentials (base64 encoded)
  # Replace with your actual development credentials
  API_KEY: REPLACE_WITH_BASE64_ENCODED_DEV_API_KEY
  DB_PASSWORD: REPLACE_WITH_BASE64_ENCODED_DEV_PASSWORD
  SECRET_TOKEN: REPLACE_WITH_BASE64_ENCODED_DEV_TOKEN

