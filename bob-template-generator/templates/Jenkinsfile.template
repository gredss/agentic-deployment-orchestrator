#!/usr/bin/env groovy

/**
 * Jenkins Pipeline for {{APP_NAME}}
 * Auto-generated by Bob Template Generator
 * 
 * This pipeline:
 * 1. Checks out code from Git
 * 2. Builds Docker image
 * 3. Pushes to OpenShift registry
 * 4. Deploys to OpenShift
 * 5. Verifies deployment health
 */

pipeline {
    agent any
    
    environment {
        APP_NAME = '{{APP_NAME}}'
        NAMESPACE = '{{OPENSHIFT_NAMESPACE}}'
        IMAGE_REGISTRY = 'image-registry.openshift-image-registry.svc:5000'
        IMAGE_NAME = "${IMAGE_REGISTRY}/${NAMESPACE}/${APP_NAME}"
        BUILD_NUMBER = "${env.BUILD_NUMBER}"
    }
    
    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
    }
    
    stages {
        
        stage('Initialize') {
            steps {
                script {
                    echo "=========================================="
                    echo "Pipeline: {{APP_NAME}}"
                    echo "=========================================="
                    echo "Build Number: ${env.BUILD_NUMBER}"
                    echo "Namespace: ${NAMESPACE}"
                    echo "Image: ${IMAGE_NAME}:${BUILD_NUMBER}"
                    echo "=========================================="
                }
            }
        }
        
        stage('Checkout') {
            steps {
                script {
                    echo "Checking out source code..."
                    checkout scm
                    sh 'ls -la'
                }
            }
        }
        
        stage('Build Image') {
            steps {
                script {
                    echo "Building Docker image..."
                    sh """
                        oc start-build ${APP_NAME} \
                          --from-dir=. \
                          --follow \
                          -n ${NAMESPACE}
                    """
                    echo "✓ Image built successfully"
                }
            }
        }
        
        stage('Deploy to OpenShift') {
            steps {
                script {
                    echo "Deploying to OpenShift..."
                    
                    // Apply Kubernetes manifests
                    sh """
                        oc apply -f k8s/deployment.yaml -n ${NAMESPACE}
                        oc apply -f k8s/service.yaml -n ${NAMESPACE}
                        oc apply -f k8s/route.yaml -n ${NAMESPACE}
                    """
                    
                    echo "✓ Manifests applied"
                }
            }
        }
        
        stage('Wait for Rollout') {
            steps {
                script {
                    echo "Waiting for deployment rollout..."
                    
                    timeout(time: 10, unit: 'MINUTES') {
                        sh """
                            oc rollout status deployment/${APP_NAME} \
                                -n ${NAMESPACE} \
                                --timeout=10m
                        """
                    }
                    
                    echo "✓ Rollout completed"
                }
            }
        }
        
        stage('Health Check') {
            steps {
                script {
                    echo "Performing health check..."
                    
                    // Get pod status
                    sh """
                        echo "=== Pod Status ==="
                        oc get pods -l app=${APP_NAME} -n ${NAMESPACE}
                    """
                    
                    // Get deployment status
                    sh """
                        echo "=== Deployment Status ==="
                        oc get deployment ${APP_NAME} -n ${NAMESPACE}
                    """
                    
                    // Get route URL
                    def routeUrl = sh(
                        script: "oc get route ${APP_NAME} -n ${NAMESPACE} -o jsonpath='{.spec.host}'",
                        returnStdout: true
                    ).trim()
                    
                    echo "=== Application URL ==="
                    echo "https://${routeUrl}"
                    
                    // Wait for pods to be ready
                    sleep(time: 10, unit: 'SECONDS')
                    
                    // Health check with retries
                    def healthCheckPassed = false
                    def maxRetries = 10
                    def retryCount = 0
                    
                    while (!healthCheckPassed && retryCount < maxRetries) {
                        try {
                            sh """
                                curl -f -k https://${routeUrl}{{HEALTH_CHECK_PATH}}
                            """
                            healthCheckPassed = true
                            echo "✓ Health check passed"
                        } catch (Exception e) {
                            retryCount++
                            echo "Health check attempt ${retryCount}/${maxRetries} failed, retrying..."
                            sleep(time: 10, unit: 'SECONDS')
                        }
                    }
                    
                    if (!healthCheckPassed) {
                        error("Health check failed after ${maxRetries} attempts")
                    }
                }
            }
        }
        
        stage('Deployment Summary') {
            steps {
                script {
                    def routeUrl = sh(
                        script: "oc get route ${APP_NAME} -n ${NAMESPACE} -o jsonpath='{.spec.host}'",
                        returnStdout: true
                    ).trim()
                    
                    echo """
                    ╔════════════════════════════════════════════════════════════╗
                    ║           DEPLOYMENT COMPLETED SUCCESSFULLY                ║
                    ╠════════════════════════════════════════════════════════════╣
                    ║ Application:     ${APP_NAME}
                    ║ Build Number:    ${BUILD_NUMBER}
                    ║ Namespace:       ${NAMESPACE}
                    ║ Replicas:        {{REPLICAS}}
                    ║
                    ║ Application URL: https://${routeUrl}
                    ║ Health Check:    https://${routeUrl}{{HEALTH_CHECK_PATH}}
                    ║
                    ║ Build Time:      ${new Date()}
                    ╚════════════════════════════════════════════════════════════╝
                    """
                }
            }
        }
    }
    
    post {
        success {
            script {
                echo "=========================================="
                echo "Pipeline Completed Successfully! ✓"
                echo "=========================================="
            }
        }
        
        failure {
            script {
                echo "=========================================="
                echo "Pipeline Failed! ✗"
                echo "=========================================="
                
                // Get logs for debugging
                sh """
                    echo "=== Recent Pod Logs ==="
                    oc logs -l app=${APP_NAME} --tail=50 -n ${NAMESPACE} || true
                """
            }
        }
        
        always {
            script {
                echo "Pipeline execution completed"
            }
        }
    }
}

