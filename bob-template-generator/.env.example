# ============================================
# Bob Template Generator - Configuration File
# ============================================
# Copy this file to .env and fill in your values

# Application Configuration
APP_NAME=my-app
APP_PORT=5000
REPLICAS=2
HEALTH_CHECK_PATH=/health

# GitHub Configuration
GITHUB_REPO=https://github.com/your-org/your-repo.git
GITHUB_BRANCH=main

# OpenShift Configuration
OPENSHIFT_NAMESPACE=production
OPENSHIFT_CLUSTER=apps.your-cluster.com

# Python Configuration
PYTHON_VERSION=3.11

# Optional: Custom Environment Variables for Your App
# Add any environment variables your app needs
# Example:
# DATABASE_URL=postgresql://user:pass@host:5432/db
# API_KEY=your-secret-key