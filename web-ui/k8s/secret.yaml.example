# Bob Web UI - Secret Manifest Template
# IMPORTANT: Copy this file to secret.yaml and replace with your actual secrets
apiVersion: v1
kind: Secret
metadata:
  name: bob-web-ui-secret
  namespace: production
  labels:
    app: bob-web-ui
type: Opaque
data:
  # Generate a random secret key:
  # python -c "import secrets; print(secrets.token_urlsafe(32))"
  # Then base64 encode it:
  # echo -n "your-secret-key" | base64
  # 
  # Example: echo -n "$(python -c 'import secrets; print(secrets.token_urlsafe(32))')" | base64
  secret-key: REPLACE_WITH_BASE64_ENCODED_SECRET_KEY

# Made with Bob