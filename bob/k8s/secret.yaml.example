apiVersion: v1
kind: Secret
metadata:
  name: bob-secrets
  namespace: production
type: Opaque
stringData:
  # OpenShift API Configuration
  # Get your token by running: oc whoami -t
  # Or from OpenShift Console: Copy login command
  openshift-token: "REPLACE_WITH_YOUR_OPENSHIFT_TOKEN"
  
  # Jenkins credentials
  # These are used for triggering Jenkins builds
  jenkins-user: "REPLACE_WITH_JENKINS_USERNAME"
  jenkins-password: "REPLACE_WITH_JENKINS_PASSWORD"
  jenkins-token: "REPLACE_WITH_JENKINS_API_TOKEN"

# Made with Bob